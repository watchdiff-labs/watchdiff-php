{
    "name": "watchdiff-labs/watchdiff-core",
    "description": "Lightweight web change monitoring - diffs, file/API/webhook alerts. Framework-agnostic PHP core.",
    "type": "library",
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/watchdiff-labs/watchdiff-php",
    "support": {
        "issues": "https://github.com/watchdiff-labs/watchdiff-php/issues",
        "source": "https://github.com/watchdiff-labs/watchdiff-php"
    },
    "keywords": [
        "watchdiff",
        "monitoring",
        "diff",
        "change-detection",
        "web-scraping",
        "webhooks"
    ],
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/css-selector": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "sebastian/diff": "^5.1 || ^6.0",
        "dragonmantank/cron-expression": "^3.4",
        "php-http/discovery": "^1.19",
        "ext-dom": "*",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.57",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Default PSR-18 HTTP client used by the CLI if no other client is installed.",
        "symfony/http-client": "Alternative PSR-18 HTTP client.",
        "ext-pdo_sqlite": "Required to use the SqliteStore backend.",
        "ext-pdo_pgsql": "Required to watch a PostgreSQL table with watchDb().",
        "ext-pdo_mysql": "Required to watch a MySQL table with watchDb().",
        "chrome-php/chrome": "Required for browser: true page rendering and screenshotOnChange (drives a real Chrome/Chromium binary).",
        "phpoffice/phpspreadsheet": "Required for exportReportsXlsx() / exportSnapshotsXlsx().",
        "symfony/mailer": "Required to send email alerts."
    },
    "autoload": {
        "psr-4": {
            "WatchDiff\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WatchDiff\\Core\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/watchdiff"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
